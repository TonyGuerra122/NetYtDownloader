<Window x:Class="GUI.ProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Instalando FFmpeg" 
    Height="150" 
    Width="400"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True">
    <Grid Background="White">
        <StackPanel VerticalAlignment="Center" Margin="20">
            <TextBlock x:Name="MessageText" Text="Iniciando download..." FontSize="14" Margin="0,0,0,10"/>
            <ProgressBar x:Name="ProgressBar" Height="25" Foreground="#0078D4"/>
            <TextBlock x:Name="PercentText" Text="0%" HorizontalAlignment="Right" Margin="0,5,0,0" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
